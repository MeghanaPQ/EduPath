DATABASE_URL=postgresql+psycopg://edupath:edupath@localhost:5432/edupath
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

NEXT_PUBLIC_API_URL=http://localhost:8000

SECRET_KEY=change-me-in-production
DEMO_MODE=false
DISCOVERY_SCHEDULE=0 8 * * *

# Optional: use SQLite for local demo without Docker Postgres
# DATABASE_URL=sqlite:///./edupath.db

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
RANKING_WEIGHT_ELIGIBILITY=0.35
RANKING_WEIGHT_CAREER=0.25
RANKING_WEIGHT_INTEREST=0.15
RANKING_WEIGHT_ACADEMIC=0.10
RANKING_WEIGHT_READINESS=0.10
RANKING_WEIGHT_DEADLINE=0.05
NOTIFY_MATCH_THRESHOLD=85

# --- Real email confirmation codes (required when DEMO_MODE=false) ---
# Option A: Resend (https://resend.com) — easiest
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=EduPath AI <onboarding@yourdomain.com>

# Option B: Gmail app password
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Create password for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=EduPath AI <your-gmail@gmail.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
AUTH_CODE_TTL_MINUTES=10
RESEND_API_KEY=

# --- Connect Gmail (Google OAuth login — preferred) ---
# 1) Google Cloud Console → APIs & Services → Enable Gmail API
# 2) Create OAuth client (Web application)
# 3) Authorized redirect URI must be exactly:
#    http://localhost:8000/api/email/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/gmail/callback
FRONTEND_URL=http://localhost:3000
